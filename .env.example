NODE_ENV=development
PORT=3000

# Optional API key for protected API routes. Leave empty locally.
API_KEY=

# Server-side OpenAI key for AI coach analysis.
OPENAI_API_KEY=

# Storage
# Use upstash for Vercel production.
# memory is useful for temporary local testing only.
STORAGE_DRIVER=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=fitsheet
