NODE_ENV=development
PORT=3000

# Optional API key for GPT Actions. Leave empty locally.
API_KEY=

# Storage
# Use json for local development.
# Use upstash for Vercel production.
# memory is useful for temporary local testing only.
STORAGE_DRIVER=json
DATA_FILE_PATH=./data/fitsheet.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=fitsheet
